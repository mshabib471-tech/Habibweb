# Habib iFix .Tech - Environment Configuration Example
# Copy to .env and fill in real production values. Never commit .env to GitHub.

# Server Port
PORT=3000

# Server Secret for cryptographically signing auth tokens
JWT_SECRET=habib_ifix_super_secret_production_key_2026_change_me

# Firebase Configuration (loaded client-side from firebase-applet-config.json)
FIREBASE_PROJECT_ID=composite-entropy-26pck
# Optional path to Firebase Admin Service Account Key (JSON)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Admin Authorized Emails (comma-separated list)
ADMIN_EMAILS=tec.habiburrahman@gmail.com,mshabib471@gmail.com

# External Service Keys
CLIPDROP_API_KEY=
GEMINI_API_KEY=

# Canonical Website URL
SITE_URL=https://habibifix.tech
