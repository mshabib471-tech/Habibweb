rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hardened Helper Functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Strict Admin Authorization:
    // Requires email verification AND matching authoritative admin allowlist or database admin document
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          isEmailVerified() && 
          request.auth.token.email != null && (
            request.auth.token.email.lower() == 'tec.habiburrahman@gmail.com' ||
            request.auth.token.email.lower() == 'mshabib471@gmail.com'
          )
        )
      ); 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }

    // 1. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Admins Collection - Role Based Access Control
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false; // Only manageable server-side or via console
    }

    // 3. Users Collection (Customer profiles & permissions)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().keys().hasAll(['email']) &&
        incoming().email is string &&
        incoming().email.size() <= 150 &&
        (!('role' in incoming()) || incoming().role == 'customer' || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (
          request.auth.uid == userId && 
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatar', 'lastLogin']) &&
          (!('role' in incoming()) || incoming().role == existing().role) &&
          (!('isBanned' in incoming()) || incoming().isBanned == existing().isBanned)
        )
      );
      allow delete: if isAdmin();
    }

    // 4. Offers Collection: Public read, Admin write
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 5. Services Collection: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 6. Courses Collection: Public read, Admin write
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 7. Posts & Blog Articles: Public read, Admin write
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 8. Repair Bookings: Users can create and read own bookings; Admin full control
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if incoming().keys().hasAll(['customerName', 'phone']) &&
        incoming().customerName is string && incoming().customerName.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() <= 30 &&
        (!isSignedIn() || !('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 9. Shop Orders: Users can create and read own orders; Admin full control
    // Users CANNOT approve or modify status (prevents fraud & self-approval)
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if incoming().keys().hasAll(['customerName', 'phone', 'address']) &&
        incoming().customerName is string && incoming().customerName.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() <= 30 &&
        incoming().address is string && incoming().address.size() <= 300 &&
        (!isSignedIn() || !('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 10. Contact Inquiries & Repair Tickets: Public create, Admin view/reply
    match /contacts/{contactId} {
      allow get, list: if isAdmin();
      allow create: if incoming().keys().hasAll(['name', 'contact', 'message']) &&
        incoming().name is string && incoming().name.size() <= 100 &&
        incoming().contact is string && incoming().contact.size() <= 100 &&
        incoming().message is string && incoming().message.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // 11. Audit Logs: Strictly Admin access
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
